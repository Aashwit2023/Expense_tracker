# ==========================================
# Money Tracker - Monorepo .gitignore
# ==========================================

# Dependencies (Root and all subdirectories)
node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (Preserve .env.example templates)
.env
.env.*
*.env
!.env.example
!.env.*.example
server/.env
client/.env
**/server/.env
**/client/.env

# Build Outputs & Bundles
dist/
**/dist/
build/
**/build/
dist-ssr/
*.tsbuildinfo

# SQLite Database & Storage Files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
dev.db
server/prisma/dev.db
**/dev.db
**/prisma/*.db
**/prisma/*.db-journal

# Logs & Debugging
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test Coverage & Artifacts
coverage/
**/coverage/
.nyc_output/
test-pg/
scratch/

# Uploads & Temporary Files
uploads/
**/uploads/
tmp/
temp/
*.tmp
*.temp

# IDE & Editor Configs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
