# ==========================================
# Personalized Money Tracker - Server Environment Variables
# ==========================================

PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars

# Allowed CORS origins for separate deployments (comma-separated or * for all)
# Example: CORS_ORIGIN="https://my-money-tracker.vercel.app"
CORS_ORIGIN=*

# Primary PostgreSQL Database URL:
DATABASE_URL="postgresql://postgres:password@localhost:5432/money_tracker?schema=public"

# SQLite dev fallback:
# DATABASE_URL="file:./dev.db"

