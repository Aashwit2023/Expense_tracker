# ==========================================
# Personalized Money Tracker - Environment Configuration
# ==========================================

# Application Port
PORT=5000

# Application Environment (development | production | test)
NODE_ENV=development

# JSON Web Token Secret
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars

# Primary PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/money_tracker?schema=public"

# For local development with zero external DB dependencies, you can also use SQLite:
# DATABASE_URL="file:./dev.db"
