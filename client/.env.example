# ==========================================
# Frontend Client Environment Variables
# ==========================================

# When deploying frontend separately (e.g. on Vercel, Netlify, Cloudflare Pages),
# specify the full public URL of your backend server API:
# Example: VITE_API_URL="https://money-tracker-api.onrender.com"
#
# When deploying frontend and backend together as a single service, or in local development,
# leave this empty or unset (it will default to '/api' and use same-origin / proxy):
VITE_API_URL=
